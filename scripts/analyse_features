except NameError:
    pass
import features_core
from features_core import DECIMALES, FEATURES_PARTIE, MANQ_MAX, SENT, nb_demi_coups, traiter_bloc

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------
# Dossier des données : variable d'environnement LICHESS_DATA, sinon <racine du dépôt>/donnees
RACINE = Path(__file__).resolve().parent.parent
DOSSIER = os.environ.get("LICHESS_DATA", str(RACINE / "donnees"))
FICHIER = "parties_filtrees.parquet"
N = None                     # nombre de parties traitées ; None = toute la base
COL_COUPS = "Moves_clean"
COL_EVALS = "Evals"
SORTIE = "resultats"

BLOC_LECTURE = 100_000       # parties lues / traitées / écrites à la fois (mémoire constante)
TAILLE_TACHE = 2_000         # parties par tâche envoyée aux processus
REPRENDRE = True             # réutiliser les blocs déjà calculés (reprise après interruption)
FUSIONNER = True             # fusionner les blocs en un seul fichier features.parquet
SUPPRIMER_BLOCS = True       # supprimer les blocs après une fusion réussie
GARDER_COUPS = True          # garder la colonne des coups (et des évaluations) dans le fichier final

